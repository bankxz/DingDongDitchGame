			["Lobby_PROP_StonePost__Marble"] = { Material = "Marble", Color = { 0.9357, 0.9212, 0.9547 } },
		},
	},
}

local LobbyAssetStyler = {}

local function applyPart(part: BasePart, spec: PartSpec)
	part.Material = (Enum.Material :: any)[spec.Material]
	part.Color = Color3.new(spec.Color[1], spec.Color[2], spec.Color[3])
	part.Reflectance = spec.Reflectance or 0
	part.Transparency = spec.Transparency or 0
	part.Anchored = true
	if spec.Texture then
		local tex = TEXTURES[spec.Texture]
		if tex and tex.ColorMap ~= "" then
			local sa = part:FindFirstChildOfClass("SurfaceAppearance") or Instance.new("SurfaceAppearance")
			sa.ColorMap = tex.ColorMap
			sa.NormalMap = tex.NormalMap
			sa.Parent = part
		else
			part.Material = Enum.Material.Slate
			part.Color = TEXTURE_FALLBACK_COLOR
		end
	end
	if spec.Material == "Neon" then
		part.CastShadow = false
	end
end

function LobbyAssetStyler.style(model: Model, unitName: string?)
	local name = unitName or model.Name
	local unit = UNITS[name]
	assert(unit, "LobbyAssetStyler: unknown unit " .. name)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local key = d.Name:gsub("%.%d+$", "")
			local spec = unit.parts[key]
			if spec then
				applyPart(d, spec)
			end
		end
	end
	-- Rescale so the model matches its Blender size (1 Blender unit = 1 stud).
	local _, extents = model:GetBoundingBox()
	local want = math.max(unit.size[1], unit.size[2], unit.size[3])
	local have = math.max(extents.X, extents.Y, extents.Z)
	if have > 0 and math.abs(have - want) / want > 0.02 then
		model:ScaleTo(model:GetScale() * want / have)
	end
end

function LobbyAssetStyler.styleAll(container: Instance)
	for _, m in container:GetDescendants() do
		if m:IsA("Model") and UNITS[m.Name] then
			LobbyAssetStyler.style(m)
		end
	end
end

LobbyAssetStyler.UNITS = UNITS
return LobbyAssetStyler
